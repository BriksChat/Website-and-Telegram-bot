# Рабочая локальная база. Она создастся автоматически при запуске API.
DATABASE_URL=sqlite:///english_learning.db
# Для публикации замените значение строкой MySQL:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE?charset=utf8mb4

# Создайте бота через @BotFather и вставьте значения только в свой файл .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

ADMIN_PASSWORD=admin123
SITE_URL=http://127.0.0.1:8000
API_URL=http://127.0.0.1:5000
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
PORT=5000
